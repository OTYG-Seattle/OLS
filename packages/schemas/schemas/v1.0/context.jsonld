      "@type": "@id"
    },
    "object": {
      "@id": "ols:object",
      "@type": "@id"
    },
    "ordo": {
      "@id": "ols:ordo",
      "@type": "@id"
    },
    "ordos": {
      "@id": "ols:ordos",
      "@type": "@id"
    },
    "overrides": {
      "@id": "ols:overrides",
