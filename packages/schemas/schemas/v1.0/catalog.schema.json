{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ols.otyg.org/schema/v1.0/catalog.schema.json",
  "title": "OLS Publisher Catalog",
  "description": "Lists the packages a publisher distributes, with every released version and its package digest. Served at /.well-known/openliturgy.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://ols.otyg.org/schema/v1.0/catalog.schema.json"
    },
    "ols_version": {
      "type": "string",
      "pattern": "^1\\.[01]\\.[0-9]+$"
    },
    "type": {
      "const": "catalog"
    },
    "publisher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "sameAs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
          },
          "uniqueItems": true,
          "description": "The same person, organization, or work in an external authority (Wikidata, VIAF, ORCID, ISNI, …)."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "$ref": "#/$defs/PackageName"
          },
          "title": {
            "$ref": "#/$defs/LocalizedText"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "$ref": "#/$defs/Digest"
                },
                "url": {
                  "type": "string",
                  "description": "Where the package archive or directory can be downloaded.",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                },
                "published": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "status": {
                  "enum": [
                    "current",
                    "superseded",
                    "withdrawn"
                  ]
                }
              },
              "required": [
                "version",
                "digest",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "package",
          "versions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "ols_version",
    "type",
    "publisher",
    "packages"
  ],
  "additionalProperties": false,
  "$defs": {
    "PackageName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "LocalizedText": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "x-ols-schema-source": "normative",
  "x-ols-specification": "https://ols.otyg.org/schema/v1.0/catalog.schema.json",
  "x-ols-revision": "1.2.0"
}
